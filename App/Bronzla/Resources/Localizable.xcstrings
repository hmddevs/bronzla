    "Aftercare": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonrası bakım"
          }
        }
      }
    },
    "Almost never burns, always darkens.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse hiç yanmaz, her zaman koyulaşır."
          }
        }
      }
    },
    "Always burns, never tans.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman yanar, hiç bronzlaşmaz."
          }
        }
      }
    },
    "An SPF of at least 30 is recommended, which blocks 97% of UVB rays, and a higher SPF does not allow additional time outdoors without reapplication.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UVB ışınlarının yüzde 97'sini engelleyen en az SPF 30 önerilir; daha yüksek bir SPF, yeniden uygulama yapılmadan dışarıda geçirilebilecek süreyi uzatmaz."
          }
        }
      }
    },
    "Apply a gentle compress with chilled aloe vera gel.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soğutulmuş aloe vera jeli ile nazikçe kompres yapın."
          }
        }
      }
    },
    "Apply a soothing, fragrance-free moisturiser.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatlatıcı, parfümsüz bir nemlendirici sürün."
          }
        }
      }
    },
    "Apply moisturiser after showering.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duştan sonra nemlendirici sürün."
          }
        }
      }
    },
    "Apply pure aloe vera gel; it soothes and moisturises.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saf aloe vera jeli sürün; yatıştırıcı ve nemlendiricidir."
          }
        }
      }
    },
    "As you log sessions, your time, streak and estimated vitamin D will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans kaydettikçe burada süre, seri ve tahmini D vitamini görünecek."
          }
        }
      }
    },
    "At UV 8, a typical summer midday": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UV 8'de, tipik bir yaz öğlesi"
          }
        }
      }
    },
    "Avoid the sun. Skin can burn within minutes.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşten kaçının. Cilt dakikalar içinde yanabilir."
          }
        }
      }
    },
