    "If the UV index will reach 8 or above the next day, we tell you in the morning.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ertesi gün UV indeksi 8 veya üzerine çıkacaksa sabah haber veririz."
          }
        }
      }
    },
    "If the burn does not clear within 2 to 3 days, or blistering is widespread, see a doctor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanık 2-3 gün içinde geçmez veya kabarcıklanma yaygınsa doktora görünün."
          }
        }
      }
    },
    "If there is fever, shivering, dizziness or nausea, go to a healthcare facility without delay.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ateş, titreme, baş dönmesi veya bulantı varsa vakit kaybetmeden bir sağlık kuruluşuna gidin."
          }
        }
      }
    },
