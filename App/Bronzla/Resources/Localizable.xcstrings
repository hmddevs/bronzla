    "Bronzla %@ (%@)": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzla %@ (%@)"
          }
        }
      }
    },
    "Bronzla does not ask you to create an account, does not track you and uses no third party analytics. Your sessions, photos and skin type are stored only on your device.\n\nYour location is used to fetch weather data and is sent to Apple Weather. In the cache it is rounded to roughly one kilometre rather than kept as an exact coordinate.\n\nYou can permanently delete all of your data with a single tap in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzla hesap açmanızı istemez, sizi takip etmez ve üçüncü taraf analiz araçları kullanmaz. Seanslarınız, fotoğraflarınız ve cilt tipiniz yalnızca cihazınızda saklanır.\n\nKonumunuz hava durumu verisi almak için kullanılır ve Apple Hava Durumu servisine iletilir. Önbellekte konumunuz yaklaşık bir kilometrelik hassasiyete yuvarlanarak tutulur, tam koordinat olarak değil.\n\nAyarlar bölümünden tüm verilerinizi tek dokunuşla kalıcı olarak silebilirsiniz."
          }
        }
      }
    },
    "Bronzla is not a medical device and does not give medical advice.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzla tıbbi bir cihaz değildir ve tıbbi tavsiye vermez."
          }
        }
      }
    },
    "Bronzla is not a substitute for an examination by a dermatologist.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzla, bir dermatolog muayenesinin yerini tutmaz."
          }
        }
      }
    },
    "BronzlaWidgets": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BronzlaWidgets"
