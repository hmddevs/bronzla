    },
    "Broad spectrum SPF 30 or higher is recommended for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes için geniş spektrumlu, SPF 30 veya üzeri bir güneş kremi önerilir."
          }
        }
      }
    },
