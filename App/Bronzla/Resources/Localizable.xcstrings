    },
    "Contrary to this common belief, oil traps heat in the skin and makes the burn worse.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yaygın inanışın aksine yağ ısıyı ciltte hapseder ve yanığı ağırlaştırır."
          }
        }
      }
    },
    "Cool baths, aloe vera or soy products, and never popping blisters.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serin banyolar, aloe vera veya soya bazlı ürünler ve su toplamalarının asla patlatılmaması gerektiği."
          }
        }
      }
    },
    "Cool compresses, and that applying ice directly damages sunburnt skin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serin kompresler ve buzun doğrudan uygulanmasının güneş yanığına uğramış cildi zedelediği."
          }
        }
      }
    },
    "Cool the area gently with cool water.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgeyi serin suyla nazikçe soğutun."
          }
        }
      }
    },
    "Cool the area with a cool, damp cloth; repeat several times a day.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serin, nemli bir bezle bölgeyi soğutun; günde birkaç kez tekrarlayın."
          }
        }
      }
    },
    "Cool the skin with a cool shower or a compress.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serin bir duş veya kompresle cildi soğutun."
          }
        }
      }
    },
    "Could not determine your location.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz belirlenemedi."
