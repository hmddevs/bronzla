      }
    },
    "Create a separate profile for each family member on the trip; every profile has its own skin type and safe time.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatile giden her aile üyesi için ayrı bir profil oluşturun; her profilin cilt tipi ve güvenli süresi farklıdır."
