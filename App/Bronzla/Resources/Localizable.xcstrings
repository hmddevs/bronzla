    "Try again": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        }
      }
    },
    "Turn over. You are halfway through the session.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer tarafınıza dönün. Seansın yarısı tamamlandı."
          }
        }
      }
    },
    "Turns painfully red, blisters and peels": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acı verecek şekilde kızarır, kabarır ve soyulur"
          }
        }
      }
    },
    "Turns red, sometimes peels": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızarır, bazen soyulur"
          }
        }
      }
    },
    "Turns slightly red": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafifçe kızarır"
          }
        }
      }
    },
    "Two hours are up. Reapply your sunscreen, especially if you have been in the sea.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki saat doldu. Güneş kremini yeniden sürün, özellikle denize girdiyseniz."
          }
        }
      }
    },
