        }
      }
    },
    "10 sessions, and you never went over the limit.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 seans, hiçbirinde sınırı aşmadınız."
          }
        }
      }
    },
    "30 sessions, zero burns.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 seans, sıfır yanık."
          }
        }
      }
    },
    "7 days in a row, zero burns.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün üst üste, sıfır yanık."
          }
        }
      }
    },
    "80 minutes is the maximum water-resistance duration a sunscreen label may claim.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir güneş kremi etiketinin iddia edebileceği azami su dayanıklılığı süresi 80 dakikadır."
          }
        }
      }
    },
    "A few": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç tane"
          }
        }
      }
    },
    "A gentle reminder": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik bir hatırlatma"
          }
        }
      }
    },
    "A great many": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla"
          }
        }
      }
    },
    "A higher SPF does not let you stay out for longer, and it has to be reapplied just the same.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek SPF güneşte daha uzun kalmanızı sağlamaz ve aynı sıklıkta yeniden sürülmesi gerekir."
          }
        }
      }
    },
    "A safe session": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir seans"
          }
        }
      }
    },
