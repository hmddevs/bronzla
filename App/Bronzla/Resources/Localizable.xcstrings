      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilt tipiniz"
          }
        }
      }
    },
    "Your skin type is the basis of your safe sun time. If it is wrong, the times are wrong too.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilt tipiniz güvenli güneşlenme sürenizin temelidir. Yanlışsa süreler de yanlış olur."
          }
        }
      }
    },
