---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import WeatherKitAttribution from '../../components/WeatherKitAttribution.astro';
import { breadcrumbList, absoluteUrl } from '../../config';

const jsonLd = [
  breadcrumbList([{ name: 'Bilimsel dayanak', path: '/tr/bilim' }], 'tr'),
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: "Bronzla'nın bilimsel dayanağı",
    url: absoluteUrl('/tr/bilim'),
    about: {
      '@type': 'MedicalCondition',
      name: 'Güneş yanığı (eritem)',
    },
    lastReviewed: '2026-08-05',
    medicalAudienceType: 'Patient',
    audience: {
