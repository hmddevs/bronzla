---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import UVScale from '../../components/UVScale.astro';
import EvidenceNote from '../../components/EvidenceNote.astro';
import StoreButton from '../../components/StoreButton.astro';
import { SITE, absoluteUrl, organizationSchema } from '../../config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS',
    url: absoluteUrl('/tr'),
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'TRY',
    },
    downloadUrl: SITE.appStoreUrl,
    publisher: organizationSchema(),
  },
  organizationSchema(),
];
---

<BaseLayout
  locale="tr"
  path="/tr"
  title="Bronzla · Güneşte güvenle kalabileceğiniz süreyi bilin"
  description="Bronzla, güncel UV indeksine, Fitzpatrick cilt tipinize ve SPF değerinize göre bugün güvenle güneşte kalabileceğiniz süreyi hesaplar. App Store'da ücretsiz; reklam yok, abonelik yok, uygulama içi satın alma yok."
  jsonLd={jsonLd}
>
  <Hero locale="tr" />

  {/* Açık bölüm: başlık kendi sütununda asılı durur, gerekçe yanında akar. */}
  <section class="container statement">
    <div class="statement-head">
      <p class="eyebrow">Yöntem</p>
      <h2>Tahmin değil, bir sayı</h2>
    </div>
    <div class="statement-body">
      <p>
        "Öğle güneşinden kaçının" kimsenin gerçekten uygulayabileceği bir tavsiye değil. Bronzla
        bunun yerine bir sayı verir: bulunduğunuz yerdeki UV indeksine, Fitzpatrick cilt tipinize
        ve taktığınız SPF'e göre hesaplanan, o gün için elinizde olan dakikalar. Her öneri,
        hesaplanan yanma süresinin yüzde 60'ıyla sınırlıdır ve hesap ne söylerse söylesin üç
        saatten fazla önerilmez.
      </p>
      <p>
        Yedi soruluk bir test, size bir grafikten kendi tipinizi seçtirmeden Fitzpatrick tipinizi
        belirler. Sorular, Akdeniz ve Ege kıyılarında yaygın olan buğday ve zeytin tonlarını kuzey
        Avrupa referans noktalarına göre değil kendi referanslarıyla tanımlar.
      </p>
      <a class="text-link" href="/tr/bilim/">Tam yöntemi ve kaynak listesini okuyun</a>
    </div>
  </section>

  {/* Yoğun panel, ikinci yükseklik. Üstündeki açık bölümden sonra bilinçli olarak sıkı. */}
  <section class="container timer-section">
    <div class="panel timer-panel">
      <div class="timer-head">
        <p class="eyebrow">Zamanlayıcı</p>
        <h2>Ekran kapalıyken de çalışan hatırlatmalar</h2>
        <p class="timer-intro">
          Dönme zamanı ve krem yenileme hatırlatmaları. Telefonunuz çantada, ekran kapalıyken de
          çalışır. Kilit ekranında canlı olarak kalan süreyi görürsünüz.
        </p>
      </div>
      <ul class="timer-list">
        <li>
          <h3>Dönme hatırlatması</h3>
          <p>Bir uyarı sizi döndürür, böylece her iki taraf da eşit güneş alır.</p>
        </li>
        <li>
          <h3>Krem hatırlatması</h3>
          <p>
            Yüzme veya havlulanma sonrası daha sık olmak üzere, her iki saatte bir yenileme
            uyarısı.
          </p>
        </li>
        <li>
          <h3>Kilit ekranında canlı</h3>
          <p>Geri sayım çalışmaya devam eder ve telefonu açmadan görünür kalır.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="container uv-section ruled">
    <div class="uv-head">
      <div>
        <p class="eyebrow eyebrow-signal">UV tahmini</p>
        <h2>Yanığı önceden görün</h2>
      </div>
      <p class="uv-lede">
        Saatlik ve on günlük UV tahmini, günün en riskli saatleri açıkça belirtilerek, evden
        çıkmadan önce bir güneş yanığını görebilirsiniz. Her okuma, uygulamanın her yerde
        kullandığı aynı beş DSÖ bandına eşlenir; şiddetle birlikte parlaklığı artacak şekilde
        renklendirildi, böylece renk körlüğünde de doğru okunur.
      </p>
    </div>
    <UVScale locale="tr" />
  </section>

  <section class="container evidence-section ruled">
    <div class="evidence-head">
      <p class="eyebrow">Kanıt</p>
      <h2>Rakamlar nereden geliyor</h2>
    </div>
    <EvidenceNote locale="tr" />
    <a class="text-link" href="/tr/bilim/">Tam yöntemi, örnek hesapları ve kaynakları görün</a>
  </section>

  {/* The statement shape again, deliberately: two uses of one layout across a page is a
      system, whereas six uses of one layout is a template. */}
  <section class="container privacy-section">
    <div class="statement-head">
      <p class="eyebrow">Gizlilik</p>
      <h2>Hesap yok, çünkü verinizi gönderecek bir yer yok</h2>
    </div>
    <div class="privacy-body">
      <p>
        Bronzla'nın arkasında bir sunucu yok. Cilt tipiniz, seans geçmişiniz ve bronzlaşma takip
        fotoğraflarınız telefonunuzda yerel olarak saklanır. Konum, yalnızca bulunduğunuz yerdeki
        UV indeksini Apple WeatherKit'ten almak için kullanılır; hiçbir zaman bir kimlikle
        eşleştirilmez ve konumu tamamen atlayıp bir şehir seçebilirsiniz. Analiz aracı yok, reklam
        yok, hiçbir üçüncü taraf yok.
      </p>
      <a class="text-link" href="/tr/gizlilik/">Gizlilik sayfasının tamamını okuyun</a>
    </div>
  </section>

  <section class="container closing-section">
    <div class="panel closing-cta">
      <h2>Ücretsiz. Reklam yok, abonelik yok, uygulama içi satın alma yok.</h2>
      <StoreButton locale="tr" size="large" />
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * Bölüm yoğunluğu tekrar edilmez, bestelenir: açık ifade, yoğun panel, sıkı şerit, sıkı
   * kanıt, açık ifade, kapanış paneli. Turkish runs longer than English, so the character
   * caps here sit a few ch wider than the English page's.
   */
  .statement {
    padding-block: 0 var(--space-open);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .statement-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .statement-head h2 {
    max-width: 14ch;
  }

  .statement-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 52ch;
  }

  .statement-body p {
    color: var(--ink-muted);
  }

  .statement-body p:first-child {
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink);
    max-width: none;
  }

  .timer-section {
    padding-block: 0 var(--space-section);
  }

  .timer-panel {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .timer-head {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 46rem;
  }

  .timer-head h2 {
    font-size: var(--text-h3);
    max-width: 26ch;
  }

  .timer-intro {
    color: var(--ink-muted);
    max-width: 60ch;
  }

  /*
   * Düz tipografi, hairline ile bölünmüş; üç ikonlu kart değil. DESIGN.md aynı ölçüdeki
   * kart ızgarasını yasaklar ve paneli zaten kapsayıcı olarak kullanıyoruz.
   */
  .timer-list {
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
  }

  .timer-list li {
    padding: 1.5rem 1.5rem 0 0;
  }

  .timer-list li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--hairline);
  }

  .timer-list h3 {
    font-size: var(--text-body);
    font-weight: var(--weight-strong);
  }

  .timer-list p {
    color: var(--ink-muted);
    font-size: var(--text-small);
    margin-top: 0.5rem;
  }

  .uv-section {
    padding-block: var(--space-section);
  }

  .uv-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .uv-head h2 {
    font-size: var(--text-h2);
    max-width: 12ch;
    margin-top: 0.85rem;
  }

  .uv-lede {
    color: var(--ink-muted);
    max-width: 58ch;
  }

  .evidence-section {
    padding-block: var(--space-tight);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /*
   * Belge hiyerarşisi için h2 kalır, boyutu h3 seviyesindedir: bu blok sayfanın dipnotudur
   * ve başlık düzeni tipografi ölçeğine göre bükülmez.
   */
  .evidence-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .evidence-head h2 {
    font-size: var(--text-h3);
  }

  .evidence-section :global(.evidence-note) {
    align-self: stretch;
  }

  .privacy-section {
    padding-block: var(--space-section) var(--space-open);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .privacy-section h2 {
    max-width: 16ch;
  }

  .privacy-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 52ch;
  }

  .privacy-body p {
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: none;
  }

  .closing-section {
    padding-block: 0 var(--space-section);
  }

  .closing-cta {
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .closing-cta h2 {
    max-width: 18ch;
  }

  @media (max-width: 60rem) {
    .statement,
    .privacy-section,
    .uv-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .uv-head {
      align-items: start;
    }
  }

  @media (max-width: 48rem) {
    .timer-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .timer-list li {
      padding-right: 0;
    }

    .timer-list li + li {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--hairline);
    }
  }
</style>
