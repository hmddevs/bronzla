---
import { SITE } from '../config';

interface Props {
  locale: 'en' | 'tr';
  size?: 'default' | 'large';
}

const { locale, size = 'default' } = Astro.props;

const label = locale === 'tr' ? "App Store'da indir" : 'Download on the App Store';
---

<a class:list={['store-button', size]} href={SITE.appStoreUrl} rel="noopener">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.365 1.43c0 1.14-.415 2.06-1.246 2.76-.918.79-1.958 1.235-2.887 1.16-.13-1.05.373-2.155 1.204-2.9C14.34.633 15.516.037 16.365 0c.02.02 0 .3 0 1.43zM20.6 17.5c-.5 1.15-.74 1.66-1.38 2.66-.9 1.4-2.16 3.14-3.72 3.16-1.39.02-1.75-.9-3.63-.9-1.88 0-2.29.88-3.61.92-1.5.05-2.65-1.5-3.56-2.9-1.94-2.98-3.42-8.42-1.43-12.08.99-1.83 2.76-2.98 4.68-3.01 1.42-.02 2.77.96 3.63.96.86 0 2.5-1.19 4.21-1.02.72.03 2.73.29 4.03 2.18-.1.06-2.4 1.4-2.38 4.19.03 3.32 2.92 4.43 2.95 4.44-.03.08-.46 1.58-1.53 3.4z"
    ></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .store-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: var(--text-body);
    text-decoration: none;
    padding: 0.9rem 1.5rem;
    border-radius: var(--radius-control);
    letter-spacing: -0.01em;
    transition: background var(--duration-control) var(--ease-out-quint);
  }

  /* The mark moves, not the button: a control that shifts under the cursor is a moving target. */
  .store-button svg {
    transition: transform var(--duration-control) var(--ease-out-quint);
  }

  .store-button:hover,
  .store-button:focus-visible {
    background: var(--accent-hover);
    color: var(--accent-ink);
  }

  .store-button:hover svg,
  .store-button:focus-visible svg {
    transform: translateY(-2px);
  }

  .store-button.large {
    font-size: var(--text-h3);
    padding: 1.05rem 1.75rem;
  }

  @media (max-width: 26rem) {
    .store-button.large {
      font-size: var(--text-body);
      padding: 0.95rem 1.4rem;
    }
  }
</style>
