---
/**
 * The WHO UV index scale, lifted from the app's own Palette.swift. The only
 * colourful element the design permits, because it is an instrument, not decoration.
 * Never relies on hue alone: every band carries its numeral range and name in text,
 * set bold and large enough to qualify as WCAG "large text" (>= 18.66px, weight 700),
 * which is what keeps the darkest text-on-band pairing (surface on the violet
 * "extreme" band, 3.60:1) within the AA large-text floor of 3:1.
 */
interface Props {
  locale: 'en' | 'tr';
}

const { locale } = Astro.props;

const bands =
  locale === 'tr'
    ? [
        { name: 'Düşük', range: '0–2', token: '--uv-low' },
        { name: 'Orta', range: '3–5', token: '--uv-moderate' },
        { name: 'Yüksek', range: '6–7', token: '--uv-high' },
        { name: 'Çok yüksek', range: '8–10', token: '--uv-very-high' },
        { name: 'Aşırı', range: '11+', token: '--uv-extreme' },
      ]
    : [
        { name: 'Low', range: '0–2', token: '--uv-low' },
        { name: 'Moderate', range: '3–5', token: '--uv-moderate' },
        { name: 'High', range: '6–7', token: '--uv-high' },
        { name: 'Very high', range: '8–10', token: '--uv-very-high' },
        { name: 'Extreme', range: '11+', token: '--uv-extreme' },
      ];
---

<ul class="uv-scale">
  {
    bands.map((band) => (
      <li class="band" style={`background: var(${band.token})`}>
        <span class="range">{band.range}</span>
        <span class="name">{band.name}</span>
      </li>
    ))
  }
</ul>

<style>
  /*
   * Five equal columns, never auto-fit: auto-fit wraps to a ragged 3-2 or 2-2-1 block on
   * a narrow viewport, which stops reading as a scale at all. Below 40rem the strip turns
   * on its side and each band becomes a full-width row, so the order still reads as an
   * ascending scale.
   */
  .uv-scale {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .band {
    color: var(--surface);
    padding: 1.1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-height: 6.5rem;
  }

  /*
   * Both lines are set at or above 19.2px and weight 700, which clears the WCAG
   * "large text" threshold (>= 14pt / 18.66px bold) needed for the darkest pairing on
   * this strip: dark text on the violet "extreme" band measures 3.60:1, which fails
   * the 4.5:1 body-text floor but clears the 3:1 large-text floor with margin.
   */
  .range {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.2;
    margin-top: auto;
    text-wrap: balance;
  }

  @media (max-width: 40rem) {
    .uv-scale {
      grid-template-columns: minmax(0, 1fr);
    }

    .band {
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
      min-height: 0;
      padding: 0.8rem 1.1rem;
    }

    .range {
      font-size: 1.35rem;
      min-width: 3.5ch;
    }

    .name {
      margin-top: 0;
    }
  }
</style>
