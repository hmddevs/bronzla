---
/**
 * Small-type citation block: the WHO UV index definition, the minimal erythemal dose
 * reference, and the fifty per cent sunscreen discount. Rules above and below, no
 * tinted callout box, no side stripe, per DESIGN.md's component spec.
 */
interface Props {
  locale: 'en' | 'tr';
}

const { locale } = Astro.props;

const items =
  locale === 'tr'
    ? [
        'UV indeksi, Dünya Sağlık Örgütü ve Dünya Meteoroloji Örgütü’nün tanımına göre hesaplanır: 1 birim = eritem ağırlıklı 25 mW/m² ışınım.',
        'Güvenli süreler, Fitzpatrick I-VI cilt fototipleri için literatürde yayınlanmış minimum eritem dozu (MED) değerlerine dayanır.',
        'Güneş kreminin gerçek hayattaki koruması, etikette yazan SPF değerinin yaklaşık yarısı kabul edilerek hesaplanır; bu, gerçek uygulama miktarlarını yansıtır.',
      ]
    : [
        'The UV index follows the World Health Organization and World Meteorological Organization definition: 1 unit = 25 mW/m² of erythemally weighted irradiance.',
        'Safe times are based on minimal erythemal dose (MED) values published in the clinical literature for Fitzpatrick phototypes I through VI.',
        'Sunscreen protection is discounted to roughly half its label SPF, reflecting how thinly it is actually applied in real-world use.',
      ];
---

<div class="evidence-note">
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .evidence-note {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding-block: 1.75rem;
  }

  /*
   * Three columns of small type, divided by hairlines. This is the densest block on the
   * landing page by design: the sections either side of it are open, and the contrast in
   * density is what stops the page reading as one uniform template.
   */
  .evidence-note ul {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: evidence;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 3vw, 2.5rem);
    max-width: none;
  }

  .evidence-note li {
    counter-increment: evidence;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .evidence-note li + li {
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    border-left: 1px solid var(--hairline);
  }

  .evidence-note li::before {
    content: counter(evidence, decimal-leading-zero);
    display: block;
    margin-bottom: 0.6rem;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  @media (max-width: 48rem) {
    .evidence-note ul {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem 0;
    }

    .evidence-note li + li {
      padding-left: 0;
      padding-top: 1.5rem;
      border-left: none;
      border-top: 1px solid var(--hairline);
    }
  }
</style>
